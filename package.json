{
  "name": "hyperos-debloat",
  "version": "5.0.0",
  "description": "HyperOS 3 / 4 通用精简模块",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('webroot',{recursive:true,force:true})\" && parcel build src/index.html --dist-dir webroot --no-source-maps --no-cache --public-url ./",
    "dev": "parcel src/index.html"
  },
  "dependencies": {
    "kernelsu": "^1.0.0"
  },
  "devDependencies": {
    "parcel": "^2.12.0"
  }
}
